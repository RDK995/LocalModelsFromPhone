# M21-T7 Report Generation - Validation Log

## Task: Generate M21-T7-reports.md from M21-T6 evidence files

### Test 1: Verbatim Report Text Match (first and last 200 characters)

Command used:
```
python3 -c "
import json, re

EVIDENCE_DIR = '/Users/ryankenny/Projects/CodingHarnessv2/.harness/evidence'
REPORT_FILE = f'{EVIDENCE_DIR}/M21-T7-reports.md'

def parse_sse(fp):
    with open(fp) as f: content = f.read()
    blocks = content.split('\n\n')
    events = []
    for block in blocks:
        if not block.strip(): continue
        lines = block.strip().split('\n')
        event = {}
        for line in lines:
            if line.startswith('event:'): event['type'] = line[6:].strip()
            elif line.startswith('data:'): 
                d = line[5:] if line[5:].startswith(' ') else line[5:]
                try: event['data'] = json.loads(d)
                except: pass
        if 'type' in event: events.append(event)
    return events

with open(REPORT_FILE) as f: content = f.read()
for qid in ['q1','q2','q3','heat']:
    section = content[content.find(f'## {qid}:'):content.find(f'## {qid}:')+1000]
    start = section.find('Status:') + len('Status:')
    end = section.find('### Sources')
    report_text = section[start:end].strip()
    
    events = parse_sse(f'{EVIDENCE_DIR}/M21-T6-{qid}-stream.txt')
    for e in events:
        if e.get('type') == 'content': content_text = e.get('data', {}).get('text', '')
    
    print(f'{qid}: First 200 chars match = {report_text[:200] == content_text[:200]}, Last 200 chars match = {report_text[-200:] == content_text[-200:]}')
"
```

